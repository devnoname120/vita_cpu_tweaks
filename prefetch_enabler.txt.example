# vita_prefetch_enabler -- copy to ur0:data/prefetch_enabler.txt
#
# Keys come first on purpose: if anything ever reads only the start of this
# file, it still sees them. Values are "on" or anything else (= off).
# LF, CRLF and bare CR line endings all work, as does a UTF-8 BOM.

probe_only=off
l1_prefetch=off
l2_prefetch=off
actlr_alloc_one_way=keep

# probe_only:   read-only recon -- dump the secure page-table layout to
#               ur0:data/prefetch_enabler.log and make NO secure writes at
#               all. Overrides the two below when on.
# l1_prefetch:  Cortex-A9 ACTLR L1 D-side prefetch + L2 prefetch hint
#               (bits 2 and 1 -- note this is two separate features)
# l2_prefetch:  ARM PL310 L2C-310 data prefetch (PREFETCH_CTRL bit 28)
#
# actlr_alloc_one_way:  on | off | keep   (tri-state, default keep)
#               ACTLR bit 8, "allocate in one cache way only". Unlike the
#               keys above this is a bit the *firmware* sets: the Cortex-A9
#               TRM says it resets to 0, but this hardware boots with it at 1
#               on all four cores, which confines L1 D-cache allocation to one
#               of the four ways. "keep" leaves it as the firmware set it;
#               "off" clears it. Verified writable and stable on retail 3.60,
#               but its performance effect is UNMEASURED - see
#               analysis/ebadmovp-investigation/README.md.
